# ---------------------------------------------------------------- database --
# Supabase project (Settings -> API). Leave unset to keep games on-device.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------- recognition --
# Where the app sends hand photos. Precedence:
#   1. VITE_RECOGNIZE_URL, if set
#   2. the Supabase Edge Function, if VITE_SUPABASE_URL is set
#   3. http://localhost:8788/recognize during `npm run dev`
#
# Point this at the local server to use it even in a production build.
# VITE_RECOGNIZE_URL=http://localhost:8788/recognize

# Name of the deployed Edge Function, when you use that path instead.
VITE_RECOGNIZE_FUNCTION=recognize-tiles

# Set only for local experiments without any server. Never ship a build with
# this set: anything in a VITE_ variable is public in the bundle.
VITE_DEV_ANTHROPIC_API_KEY=

# ------------------------------------------ local recognition server (node) --
# These are read by `npm run recognize`, not by the browser.
#
# Provider is auto-selected: Anthropic key, then an OpenAI-compatible endpoint,
# then the Hermes CLI. Force one with RECOGNIZE_PROVIDER=hermes|anthropic|openai.
# RECOGNIZE_PROVIDER=hermes
# RECOGNIZE_PORT=8788
# RECOGNIZE_TIMEOUT_MS=180000

# Provider: Anthropic API key.
# ANTHROPIC_API_KEY=sk-ant-...

# Provider: any OpenAI-compatible endpoint, e.g. `hermes proxy start`.
# RECOGNIZE_BASE_URL=http://127.0.0.1:8645/v1
# RECOGNIZE_API_KEY=local
# RECOGNIZE_MODEL=gpt-5.6-terra

# Provider: Hermes CLI. Found automatically from HERMES_HOME; override here.
# HERMES_BIN=C:\Users\you\AppData\Local\hermes\hermes-agent\venv\Scripts\hermes.exe
